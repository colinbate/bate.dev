---
import Icon from "../global/icon.svelte";
---

<main aria-labelledby="header" class="relative overflow-hidden">
    <h2 class="sr-only" id="header">About Colin</h2><div
        class="max-w-6xl px-8 mx-auto py-12 lg:pt-28"
    >
        <div>
            <h1
                class="text-white mt-4 font-bold text-5xl lg:text-8xl tracking-tighter"
            >
                About bate.dev
            </h1>
            <div
                class="mt-8 max-w-2xl prose prose-hover:a:text-accent-300 prose-a:text-white prose-a:underline prose-blockquote:border-l-2 prose-blockquote:font-light prose-blockquote:text-white/50 prose-code:text-white prose-figcaption:pb-6 prose-figcaption:text-accent-300 prose-figcaption:text-base prose-h1:font-semibold lg:prose-h1:text-8xl prose-h1:text-5xl prose-h1:tracking-tighter lg:prose-h4:text-2xl prose-h4:text-xl prose-headings:text-white prose-img:aspect-square prose-img:object-cover prose-img:w-full lg:prose-li:text-xl prose-li:marker:text-white prose-li:text-lg prose-mark:bg-accent-300 lg:prose-p:text-xl prose-p:text-lg prose-strong:text-white space-y-6 text-white/70 prose-table:divide-white/20"
            >
                <h4>
                    Welcome to my online home away from home. Here you will find
                    code, books, and the general ramblings of a middle aged
                    software engineer living in Bermuda.
                </h4>
                <p class="mt-6">
                    An archive of my past sites is available at <a
                        href="https://colinbate.com"
                        class="text-orange-500!">colinbate.com</a
                    > and my projects and writing about TTRPGs are at <a
                        href="https://ttrpg.tools"
                        class="text-emerald-500!">TTRPG.tools</a
                    >.
                </p>
            </div>
        </div>
        <div class="mt-12">
            <article>
                <img
                    class="w-full object-cover"
                    src="https://gallery.colinbate.com/photos/december-in-bermuda_4164809890_o.jpg"
                    alt="Hammock on the beach"
                    width="1088"
                    height="816"
                />
            </article>
        </div>
        <div class="max-w-5xl mt-12">
            <h3
                class="text-accent-400 mt-4 font-semibold leading-loose text-5xl tracking-tighter"
            >
                h-card
            </h3>
            <div
                class="h-card sm:w-72 shrink-0 mx-[10vw] mt-8 sm:mx-0 sm:mt-0 flex flex-col md:flex-row gap-6"
            >
                <div>
                    <img
                        class="aspect-3/2 w-full rounded-2xl object-cover u-photo md:min-w-80"
                        src="https://res.cloudinary.com/colinbate/image/upload/t_w607/colin-evening_dix5o4.jpg"
                        alt="Photo of Colin"
                    />
                </div>
                <div>
                    <h3 class="text-lg font-semibold leading-8 text-white">
                        I'm <span class="p-given-name">Colin</span>{" "}
                        <span class="p-family-name">Bate</span>
                    </h3>
                    <p
                        class="mt-4 text-base leading-7 text-white/70 md:min-w-80"
                    >
                        <span class="p-note"
                            >I am a software developer, father, audiobook
                            enthusiast and a tabletop RPG player.</span
                        >
                    </p>
                    <ul role="list" class="mt-6 flex gap-x-6 text-white">
                        <li>
                            <a
                                href="https://github.com/colinbate/"
                                rel="me"
                                class="u-url hover:text-accent-300"
                            >
